{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "research-tree/config.schema.json",
  "title": "research-tree project configuration, version 3",
  "description": "The sole bounded-screening, incremental-discovery workflow. Earlier configuration versions require an explicit new project; they are never reinterpreted.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "platform",
    "design",
    "evidence_policy",
    "metric_specs",
    "verification",
    "budget",
    "search",
    "memory",
    "notify",
    "models"
  ],
  "properties": {
    "version": {
      "const": 3
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dev",
        "experiment",
        "skills"
      ],
      "properties": {
        "dev": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "experiment": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:-]+$"
          },
          "uniqueItems": true
        }
      }
    },
    "design": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code_review",
        "sanity_first",
        "overrun_factor"
      ],
      "properties": {
        "code_review": {
          "type": "boolean"
        },
        "sanity_first": {
          "type": "boolean"
        },
        "overrun_factor": {
          "type": "number",
          "exclusiveMinimum": 1
        }
      }
    },
    "evidence_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "require_artifact_import"
      ],
      "properties": {
        "require_artifact_import": {
          "type": "boolean"
        }
      }
    },
    "metric_specs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "screening_seeds",
        "replication_seeds",
        "confirmation_seeds",
        "min_confirmation_pairs",
        "max_confirmation_candidates"
      ],
      "properties": {
        "screening_seeds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer"
          },
          "uniqueItems": true
        },
        "replication_seeds": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "uniqueItems": true
        },
        "confirmation_seeds": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "uniqueItems": true
        },
        "min_confirmation_pairs": {
          "type": "integer",
          "minimum": 1
        },
        "max_confirmation_candidates": {
          "type": "integer",
          "minimum": 1
        },
        "confirmation_materials": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "seeds"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "seeds": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "integer"
                },
                "uniqueItems": true
              },
              "split_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "manifest_field": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string"
              }
            }
          }
        },
        "independence_fields": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "S3: manifest fields naming a run's independent repeat unit; a missing value is never a new unit"
        },
        "repetition": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "se_multiple": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "batch": {
              "type": "integer",
              "minimum": 1
            },
            "seed_pool": {
              "type": "array",
              "items": {
                "type": "integer"
              },
              "uniqueItems": true
            }
          },
          "description": "S7: the fixed repetition-advice rule (search/replicate seeds only, never confirmation seeds)"
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "per_run",
        "total_limit",
        "search_limit",
        "confirmation_limit",
        "repair_limit",
        "screen_node_h",
        "max_parallel_workers",
        "alert_node_h",
        "review_usd_alert"
      ],
      "properties": {
        "per_run": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "nodes",
            "walltime"
          ],
          "properties": {
            "nodes": {
              "type": "integer",
              "minimum": 1
            },
            "walltime": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "type": "string",
                  "pattern": "^(?=\\d)(\\d+h)?(\\d+m)?(\\d+s)?$"
                }
              ]
            }
          }
        },
        "total_limit": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "search_limit": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "confirmation_limit": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "repair_limit": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "screen_node_h": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_parallel_workers": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "alert_node_h": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "review_usd_alert": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        }
      }
    },
    "search": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exploration_fraction",
        "max_repairs_per_root_cause",
        "require_selection_rationale",
        "allow_repair_from_retired_evidence",
        "stall_structural_at",
        "stall_human_at"
      ],
      "properties": {
        "exploration_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "max_repairs_per_root_cause": {
          "type": "integer",
          "minimum": 0
        },
        "require_selection_rationale": {
          "type": "boolean"
        },
        "allow_repair_from_retired_evidence": {
          "type": "boolean"
        },
        "stall_structural_at": {
          "type": "integer",
          "minimum": 1
        },
        "stall_human_at": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "include_counterevidence",
        "max_items_per_task",
        "pack_limit_chars"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "max_items_per_task": {
          "type": "integer",
          "minimum": 1
        },
        "include_counterevidence": {
          "type": "boolean"
        },
        "pack_limit_chars": {
          "type": "integer",
          "minimum": 1000
        }
      }
    },
    "notify": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "timeout_s"
      ],
      "properties": {
        "url": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^https?://"
        },
        "timeout_s": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 120
        }
      }
    },
    "models": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ui",
        "worker",
        "reviewer",
        "explorer",
        "architect",
        "analyst"
      ],
      "properties": {
        "ui": {
          "$ref": "#/$defs/model"
        },
        "worker": {
          "$ref": "#/$defs/model"
        },
        "reviewer": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "model",
            "thinking",
            "require_cross_family",
            "timeout_s"
          ],
          "properties": {
            "model": {
              "type": "string",
              "pattern": "^[a-z0-9_-]+/[A-Za-z0-9_.:\\[\\]-]+$"
            },
            "thinking": {
              "enum": [
                "off",
                "minimal",
                "low",
                "medium",
                "high",
                "xhigh",
                "max"
              ]
            },
            "require_cross_family": {
              "type": "boolean"
            },
            "timeout_s": {
              "type": "integer",
              "minimum": 30
            }
          }
        },
        "explorer": {
          "$ref": "#/$defs/model"
        },
        "architect": {
          "$ref": "#/$defs/model"
        },
        "analyst": {
          "$ref": "#/$defs/model"
        }
      }
    }
  },
  "$defs": {
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "effort"
      ],
      "properties": {
        "model": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:\\[\\]-]+$"
        },
        "effort": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "enum": [
                "low",
                "medium",
                "high",
                "xhigh",
                "max"
              ]
            },
            {
              "type": "integer",
              "minimum": 1
            }
          ]
        }
      }
    }
  }
}
