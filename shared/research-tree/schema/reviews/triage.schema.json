{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "required": [
  "ranking",
  "high_upside_pick"
 ],
 "properties": {
  "ranking": {
   "type": "array",
   "items": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": [
     "candidate_id",
     "rank",
     "best_case",
     "strongest_objection",
     "failure_mode",
     "prior_work_is_blocking",
     "pilot_worthy"
    ],
    "properties": {
     "candidate_id": {
      "type": "string",
      "minLength": 1
     },
     "rank": {
      "type": "integer",
      "minimum": 1
     },
     "best_case": {
      "type": "string",
      "minLength": 1
     },
     "strongest_objection": {
      "type": "string",
      "minLength": 1
     },
     "failure_mode": {
      "type": "string",
      "minLength": 1
     },
     "prior_work_is_blocking": {
      "type": "boolean"
     },
     "pilot_worthy": {
      "type": "boolean"
     }
    }
   },
   "minItems": 1
  },
  "high_upside_pick": {
   "type": [
    "string",
    "null"
   ]
  }
 },
 "title": "triage"
}
