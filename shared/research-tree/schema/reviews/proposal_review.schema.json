{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "required": [
  "scores",
  "overall",
  "verdict",
  "drift_warning",
  "action_items"
 ],
 "properties": {
  "scores": {
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "type": "object",
   "required": [
    "problem_fidelity",
    "method_specificity",
    "contribution_quality",
    "feasibility",
    "validation_focus"
   ],
   "properties": {
    "problem_fidelity": {
     "type": "number",
     "minimum": 0,
     "maximum": 10
    },
    "method_specificity": {
     "type": "number",
     "minimum": 0,
     "maximum": 10
    },
    "contribution_quality": {
     "type": "number",
     "minimum": 0,
     "maximum": 10
    },
    "feasibility": {
     "type": "number",
     "minimum": 0,
     "maximum": 10
    },
    "validation_focus": {
     "type": "number",
     "minimum": 0,
     "maximum": 10
    }
   }
  },
  "overall": {
   "type": "number",
   "minimum": 0,
   "maximum": 10
  },
  "verdict": {
   "enum": [
    "READY",
    "REVISE",
    "RETHINK"
   ]
  },
  "drift_warning": {
   "type": [
    "string",
    "null"
   ]
  },
  "action_items": {
   "type": "array",
   "items": {
    "type": "string",
    "minLength": 1
   },
   "minItems": 0
  }
 },
 "title": "proposal_review"
}
