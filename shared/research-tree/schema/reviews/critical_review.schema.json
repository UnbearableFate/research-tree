{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "type": "object",
 "required": [
  "stance",
  "named_risks",
  "cheapest_discriminating_experiment",
  "missing_evidence"
 ],
 "properties": {
  "stance": {
   "enum": [
    "proceed",
    "abandon"
   ]
  },
  "named_risks": {
   "type": "array",
   "items": {
    "type": "string",
    "minLength": 1
   },
   "minItems": 0
  },
  "cheapest_discriminating_experiment": {
   "type": "string",
   "minLength": 1
  },
  "missing_evidence": {
   "type": "array",
   "items": {
    "type": "string",
    "minLength": 1
   },
   "minItems": 0
  }
 },
 "title": "critical_review"
}
