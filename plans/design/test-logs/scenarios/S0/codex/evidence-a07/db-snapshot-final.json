uthor_role": "rld", "author_id": "main", "created_at": "2026-10-08T19:28:16Z", "sha256": "8258a7e49078101ad33d007a3cc6f60a7e75a639c0b12eadbf4d4e9ab7f221f0"}, {"id": "D-0011", "path": "project/reports/init-plan.v1.md", "version": 1, "doc_type": "report", "title": "ToyOpt Lab立项计划与待确认方案", "summary": "记录目标、最小设定、初始假说、配置、已核验相关工作与确认后根任务。", "status": "superseded", "author_role": "rld", "author_id": "main", "created_at": "2026-10-08T19:28:34Z", "sha256": "3391173bdd53af88b0e074d5f4453cd6ed0171dea71837a67bb4decc272c73e5"}, {"id": "D-0012", "path": "instructions/UI-0002.v1.md", "version": 1, "doc_type": "user_instruction", "title": "我的决定（计划里如有待定项按此处理）：评测类型用 synthetic_proxy（合成数据上的真实计算，结论只限于本合成任务）；只比较 accuracy；代码仓", "summary": "按用户决定固定synthetic_proxy评测、唯一正式比较指标accuracy，并将code/作为唯一代码仓库；不在项目根目录创建git提交。根任务确认后运行参考方法三个seed，逐个导入并确认valid；完成后立即暂停，不写baseline result、不调用evaluate_experiment、不设置SOTA，向用户报告每个run的输出目录并等待用户提交其基线报告供RLD登记。更新立项计划与根节点任务新版本，再请求用户确认。", "status": "current", "author_role": "ui", "author_id": "ui", "created_at": "2026-10-08T19:29:30Z", "sha256": "fc5e773e8ce426b78cd2aca4603ef0c994d0b24c52beafbcd3039ad026e2ffa5"}, {"id": "D-0013", "path": "tasks/root-harness-request.v2.md", "version": 2, "doc_type": "task_request", "title": "根节点框架与基线任务请求（用户修订）", "summary": "基线三seed全部导入且valid后暂停，不写结果文档或evaluate，向用户报告输出目录。", "status": "current", "author_role": "rld", "author_id": "main", "created_at": "2026-10-08T19:30:26Z", "sha256": "1bfce9afe8be3a95354f1246e01a62e7ef222b553caf520fb4e36a586e64cb60"}, {"id": "D-0014", "path": "project/reports/init-plan.v2.md", "version": 2, "doc_type": "report", "title": "ToyOpt Lab立项计划（按用户决定修订）", "summary": "落实评测范围、accuracy唯一指标、code仓库边界及基线报告交接后请求确认。", "status": "current", "author_role": "rld", "author_id": "main", "created_at": "2026-10-08T19:30:42Z", "sha256": "162eb4e03b09c9a83aa1724b2f4f60841e83ba97430a8ebad72e55c2d55f30e4"}, {"id": "D-0015", "path": "project/config.v2.yaml", "version": 2, "doc_type": "config", "title": "项目配置", "summary": "research-tre